{
  "name": "mkp-support-ease",
  "private": true,
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "dev:workbench": "vite --mode workbench",
    "build:workbench": "tsc -b && vite build --mode workbench",
    "tauri:workbench:dev": "tauri dev --config src-tauri/tauri.workbench.conf.json --features workbench",
    "tauri:workbench:build": "tauri build --config src-tauri/tauri.workbench.conf.json --features workbench",
    "preview": "vite preview",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --fix",
    "tauri": "tauri",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.14.0",
    "@tauri-apps/cli": "2.11.5",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.14.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "globals": "15.12.0",
    "stylelint": "16.10.0",
    "stylelint-config-standard": "36.0.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.13.0",
    "vite": "5.4.11"
  }
}
