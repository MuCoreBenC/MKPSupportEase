{
  "name": "mkp-support-ease",
  "private": true,
  "version": "0.0.11-preview.2",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "dev:workbench": "vite --mode workbench",
    "build:workbench": "tsc -b && vite build --mode workbench",
    "tauri:workbench": "node scripts/tauri-workbench.mjs",
    "tauri:workbench:dev": "node scripts/tauri-workbench.mjs dev",
    "tauri:workbench:build": "node scripts/tauri-workbench.mjs build",
    "preview": "vite preview",
    "lint": "eslint . && stylelint \"src/**/*.css\" && node scripts/check-locate.mjs && node scripts/check-release-cli.mjs && node scripts/check-copy.mjs && node scripts/check-no-factory-defaults.mjs",
    "test": "vitest run",
    "qa": "node scripts/qa/run.mjs",
    "qa:legacy": "node scripts/qa/run.mjs --legacy",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --fix",
    "tauri": "node scripts/tauri-dev.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "preset-source:dev": "node scripts/preset-test-server/server.mjs",
    "local-release": "node scripts/local-release.mjs",
    "dev:test-update": "node scripts/preset-test-server/dev.mjs",
    "release": "node scripts/release.mjs",
    "version:check": "node scripts/version.mjs check",
    "version:ensure": "node scripts/version.mjs ensure-preview",
    "preview:build": "node scripts/version.mjs ensure-preview && npm run tauri -- build && node scripts/local-release.mjs",
    "version:release": "node scripts/version.mjs release",
    "version:next": "node scripts/version.mjs next",
    "presets": "cargo run --quiet -p mkp-support-ease --features workbench --bin presets --",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:zero-network": "node scripts/check-zero-network.mjs",
    "check:channel-args": "node scripts/check-channel-args.mjs",
    "check:release-source": "node scripts/check-release-source.mjs",
    "check:calibration-assets": "node scripts/check-calibration-assets.mjs",
    "check:artifacts": "node scripts/check-artifact-boundary.mjs",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --all-targets -p mkp-support-ease --features workbench -- -D warnings",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "translations:todo": "node scripts/stale-translations.mjs",
    "glue:check": "node scripts/glue-check.mjs",
    "bambu:layers": "node scripts/bambu-layers.mjs",
    "preview:deliver": "cargo run -q --bin preview --features workbench -- deliver",
    "preview:recover": "cargo run -q --bin preview --features workbench -- recover",
    "clean:target": "./scripts/clean-target.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.14.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.14.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "globals": "15.12.0",
    "playwright-core": "^1.63.0",
    "stylelint": "16.10.0",
    "stylelint-config-standard": "36.0.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.13.0",
    "vite": "5.4.11",
    "vitest": "^3.2.7"
  }
}
