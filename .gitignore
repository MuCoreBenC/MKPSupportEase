# 依赖与产物
node_modules
dist
dist-ssr
src-tauri/target

# tsc -b 的增量编译缓存。每次 build 都重写，内容含本机绝对路径 ——
# 入库只会让每个人的每次构建都产生一条假改动。
*.tsbuildinfo

# Tauri 生成物：权限 schema 由 build.rs 按 capabilities/ 重新生成，不入库
src-tauri/gen/schemas

# 本地覆盖
*.local
.env
.env.*

# 后厨工作台的未保存编辑（B03）。草稿是"关掉再开还在那个状态"用的**本机**状态，
# 入库只会让每次开工作台都产生假改动。
# 其余 workbench/ 下的东西全部入库 —— 那是开发源数据，就该跟着 git 走。
workbench/.draft/

# 系统
.DS_Store
Thumbs.db

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea
