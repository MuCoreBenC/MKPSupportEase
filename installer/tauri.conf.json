{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SupportEase Setup",
  "version": "0.1.0",
  "identifier": "com.mucorebenc.support-ease.installer",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SupportEase 安装程序",
        "width": 540,
        "height": 430,
        "minWidth": 540,
        "minHeight": 430,
        "maxWidth": 540,
        "maxHeight": 430,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
